{
  "name": "thicket",
  "version": "0.0.0",
  "private": true,
  "description": "Thicket, a desktop client for MongoDB",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "apps/desktop",
    "packages/contract",
    "packages/core",
    "packages/backend",
    "packages/renderer"
  ],
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm run test",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run && npm run test -w packages/renderer",
    "test:int": "vitest run --config test/integration/vitest.config.ts",
    "test:e2e": "npm run build -w packages/renderer && npm run build -w apps/desktop && playwright test",
    "test:smoke": "playwright test -c test/e2e/smoke/playwright.config.ts",
    "test:electron": "npm run build -w packages/renderer && npm run test:electron -w apps/desktop",
    "dev": "npm run dev -w apps/desktop",
    "start": "npm run build -w packages/renderer && npm run start -w apps/desktop",
    "dist": "npm run dist -w apps/desktop",
    "coverage": "npm run coverage --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/node-forge": "^1.3.14",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "mongodb": "^7.9.0",
    "node-forge": "^1.4.3",
    "prettier": "^3.10.1",
    "testcontainers": "^12.2.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.2",
    "vitest": "^5.1.0"
  }
}
