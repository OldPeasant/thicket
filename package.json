{
  "name": "thicket",
  "version": "0.0.0",
  "private": true,
  "description": "Thicket, a desktop client for MongoDB",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "apps/desktop",
    "packages/contract",
    "packages/core",
    "packages/backend",
    "packages/renderer"
  ],
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm run test",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run && npm run test -w packages/renderer",
    "coverage": "npm run coverage --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.2",
    "vitest": "^5.1.0"
  }
}
