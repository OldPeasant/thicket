{
  "name": "@thicket/core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure TS shared by renderer and backend (no Node or Electron APIs)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./bson": "./src/bson/index.ts",
    "./codegen": "./src/codegen/index.ts",
    "./diff": "./src/diff/index.ts",
    "./paging": "./src/paging/index.ts",
    "./shellsyntax": "./src/shellsyntax/index.ts",
    "./uri": "./src/uri/index.ts",
    "./testing": "./src/bson/fixtures.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
