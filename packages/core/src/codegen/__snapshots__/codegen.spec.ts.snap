    coll = client["lab"]["odd"]
    cursor = coll.find(
        {
            "$or": [{"low": MinKey()}, {"high": MaxKey()}],
            "script": Code("function () { return 1; }"),
            "nan": float("nan"),
            "inf": float("inf"),
            "ninf": float("-inf"),
            "negZero": -0.0,
            "huge": 1e+300,
            "tiny": 5e-324
        }
    )
    for doc in cursor:
        print(json_util.dumps(doc))
finally:
    client.close()
"
`;

exports[`generateCode samples > python > pipeline match, group, sort 1`] = `
"from bson import json_util
from pymongo import MongoClient

client = MongoClient("mongodb://localhost:27017")
try:
    coll = client["shop"]["orders"]
    cursor = coll.aggregate([
        {"$match": {"status": "open"}},
        {
            "$group": {
                "_id": "$customer",
                "total": {"$sum": "$total"},
                "n": {"$sum": 1}
            }
        },
        {"$sort": {"total": -1}},
        {"$limit": 10}
    ])
    for doc in cursor:
        print(json_util.dumps(doc))
finally:
    client.close()
"
`;

exports[`generateCode samples > python > pipeline with typed values 1`] = `
"from datetime import datetime, timezone

from bson import Decimal128, Int64, Timestamp, json_util
from pymongo import MongoClient

client = MongoClient("mongodb://localhost:27017")
try:
    coll = client["shop"]["orders"]
    cursor = coll.aggregate([
        {
            "$match": {
                "createdAt": {
                    "$gte": datetime(2020, 2, 29, 12, tzinfo=timezone.utc)
                },
                "amount": {"$in": [Int64(5), Decimal128("1.10"), 2.0, 7]}
            }
        },
        {
            "$addFields": {
                "tags": ["a", "b"],
                "nested": {"deep": {"deeper": [1, [2, [3]]]}},
                "ts": Timestamp(4294967295, 4294967295)
            }
        },
        {"$project": {"_id": 0}}
    ])
    for doc in cursor:
        print(json_util.dumps(doc))
finally:
    client.close()
"
`;

