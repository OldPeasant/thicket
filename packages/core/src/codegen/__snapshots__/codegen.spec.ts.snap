"const { BSON, BSONRegExp, Binary, MongoClient, Timestamp, UUID } = require('mongodb');

async function main() {
  const client = new MongoClient("mongodb://localhost:27017");
  try {
    const coll = client.db("files").collection("blobs");
    const cursor = coll.find(
      {
        hash: Binary.createFromBase64("AAECAwQ=", 0),
        owner: new UUID("0e5a6b43-1f2c-4d8e-9a7b-6c5d4e3f2a1b"),
        name: new BSONRegExp("^report-\\\\d+\\\\.pdf$", "i"),
        op: new Timestamp({ t: 1700000000, i: 7 })
      },
      { collation: { locale: "en", strength: 2 } }
    );
    for await (const doc of cursor) {
      console.log(BSON.EJSON.stringify(doc));
    }
  } finally {
    await client.close();
  }
}

main().catch((error) => {
  console.error(error);
  process.exitCode = 1;
});
"
`;

