"import com.mongodb.client.MongoClient;
import com.mongodb.client.MongoClients;
import com.mongodb.client.MongoCollection;
import java.util.Arrays;
import org.bson.Document;

public class Query {
    public static void main(String[] args) {
        try (MongoClient client = MongoClients.create("mongodb://localhost:27017")) {
            MongoCollection<Document> coll =
                    client.getDatabase("my-db").getCollection("weird.names");
            coll.find(new Document("a.b", "quote \\" and backslash \\\\")
                .append("with space", "line\\nbreak\\ttab")
                .append("__proto__", "x")
                .append("ünï", "çödé ✓")
                .append("$expr", new Document("$eq", Arrays.asList("$a", "$b"))))
                .sort(new Document("a.b", 1))
                .forEach(doc -> System.out.println(doc.toJson()));
        }
    }
}
"
`;

exports[`generateCode samples > java > find with binary, uuid, regex and timestamp 1`] = `
"import com.mongodb.client.MongoClient;
import com.mongodb.client.MongoClients;
import com.mongodb.client.MongoCollection;
import com.mongodb.client.model.Collation;
import com.mongodb.client.model.CollationStrength;
import java.util.Base64;
import java.util.UUID;
import org.bson.BsonBinary;
import org.bson.BsonRegularExpression;
import org.bson.BsonTimestamp;
import org.bson.Document;
import org.bson.types.Binary;

public class Query {
    public static void main(String[] args) {
        try (MongoClient client = MongoClients.create("mongodb://localhost:27017")) {
            MongoCollection<Document> coll =
                    client.getDatabase("files").getCollection("blobs");
            coll.find(new Document(
                "hash",
                new Binary((byte) 0, Base64.getDecoder().decode("AAECAwQ="))
            )
                .append(
                    "owner",
                    new BsonBinary(UUID.fromString("0e5a6b43-1f2c-4d8e-9a7b-6c5d4e3f2a1b"))
                )
                .append(
                    "name",
                    new BsonRegularExpression("^report-\\\\d+\\\\.pdf$", "i")
                )
                .append("op", new BsonTimestamp(1700000000, 7)))
                .collation(Collation.builder()
                    .locale("en")
                    .collationStrength(CollationStrength.fromInt(2))
                    .build())
                .forEach(doc -> System.out.println(doc.toJson()));
        }
    }
}
"
`;

exports[`generateCode samples > java > find with deprecated types 1`] = `
"import com.mongodb.client.MongoClient;
import com.mongodb.client.MongoClients;
import com.mongodb.client.MongoCollection;
import org.bson.BsonDbPointer;
import org.bson.BsonUndefined;
import org.bson.Document;
import org.bson.types.CodeWithScope;
import org.bson.types.ObjectId;
import org.bson.types.Symbol;

public class Query {
    public static void main(String[] args) {
        try (MongoClient client = MongoClients.create("mongodb://localhost:27017")) {
            MongoCollection<Document> coll =
                    client.getDatabase("legacy").getCollection("old");
            coll.find(new Document("sym", new Symbol("abc"))
                .append("undef", new BsonUndefined())
                .append(
                    "ptr",
                    new BsonDbPointer("other.coll", new ObjectId("65a1b2c3d4e5f60718293a4b"))
                )
                .append(
                    "scoped",
                    new CodeWithScope(
                        "function () { return x; }",
                        new Document("x", 1)
                    )
                ))
                .forEach(doc -> System.out.println(doc.toJson()));
        }
    }
}
"
`;

exports[`generateCode samples > java > find with filter, projection, sort, skip and limit 1`] = `
"import com.mongodb.client.MongoClient;
import com.mongodb.client.MongoClients;
import com.mongodb.client.MongoCollection;
import org.bson.Document;
import org.bson.types.Decimal128;

public class Query {
    public static void main(String[] args) {
        try (MongoClient client = MongoClients.create("mongodb://localhost:27017")) {
            MongoCollection<Document> coll =
                    client.getDatabase("shop").getCollection("orders");
            coll.find(new Document("status", "open")
                .append(
                    "total",
                    new Document("$gt", Decimal128.parse("100.50"))
                ))
                .projection(new Document("_id", 0)
                    .append("status", 1)
                    .append("total", 1))
                .sort(new Document("total", -1).append("_id", 1))
                .skip(10)
                .limit(5)
                .forEach(doc -> System.out.println(doc.toJson()));
        }
    }
}
"
`;

exports[`generateCode samples > java > find with ids, dates and numbers 1`] = `
"import com.mongodb.client.MongoClient;
import com.mongodb.client.MongoClients;
import com.mongodb.client.MongoCollection;
import java.time.Instant;
import java.util.Date;
import org.bson.Document;
import org.bson.types.ObjectId;

public class Query {
    public static void main(String[] args) {
        try (MongoClient client = MongoClients.create("mongodb://localhost:27017")) {
            MongoCollection<Document> coll =
                    client.getDatabase("shop").getCollection("events");
            coll.find(new Document(
                "_id",
                new ObjectId("65a1b2c3d4e5f60718293a4b")
            )
                .append(
                    "at",
                    new Document(
                        "$gte",
                        Date.from(Instant.parse("2024-01-02T03:04:05.678Z"))
                    )
                        .append(
                            "$lt",
                            Date.from(Instant.parse("2025-01-01T00:00:00.000Z"))
                        )
                )
                .append("count", 42)
                .append("big", 9007199254740993L)
                .append("ratio", 0.25)
                .append("whole", 3.0)
                .append("flag", true)
                .append("missing", null))
                .forEach(doc -> System.out.println(doc.toJson()));
        }
    }
}
"
`;

exports[`generateCode samples > java > find with min/max keys, code and special doubles 1`] = `
"import com.mongodb.client.MongoClient;
import com.mongodb.client.MongoClients;
import com.mongodb.client.MongoCollection;
import java.util.Arrays;
import org.bson.Document;
import org.bson.types.Code;
import org.bson.types.MaxKey;
import org.bson.types.MinKey;

public class Query {
    public static void main(String[] args) {
        try (MongoClient client = MongoClients.create("mongodb://localhost:27017")) {
            MongoCollection<Document> coll =
                    client.getDatabase("lab").getCollection("odd");
            coll.find(new Document(
                "$or",
                Arrays.asList(
                    new Document("low", new MinKey()),
                    new Document("high", new MaxKey())
                )
            )
                .append("script", new Code("function () { return 1; }"))
                .append("nan", Double.NaN)
                .append("inf", Double.POSITIVE_INFINITY)
                .append("ninf", Double.NEGATIVE_INFINITY)
                .append("negZero", -0.0)
                .append("huge", 1e+300)
                .append("tiny", 5e-324))
                .forEach(doc -> System.out.println(doc.toJson()));
        }
    }
}
"
`;

exports[`generateCode samples > java > pipeline match, group, sort 1`] = `
"import com.mongodb.client.MongoClient;
import com.mongodb.client.MongoClients;
import com.mongodb.client.MongoCollection;
import java.util.List;
import org.bson.Document;

public class Query {
    public static void main(String[] args) {
        try (MongoClient client = MongoClients.create("mongodb://localhost:27017")) {
            MongoCollection<Document> coll =
                    client.getDatabase("shop").getCollection("orders");
            coll.aggregate(List.of(
                new Document("$match", new Document("status", "open")),
                new Document(
                    "$group",
                    new Document("_id", "$customer")
                        .append("total", new Document("$sum", "$total"))
                        .append("n", new Document("$sum", 1))
                ),
                new Document("$sort", new Document("total", -1)),
                new Document("$limit", 10)
            ))
                .forEach(doc -> System.out.println(doc.toJson()));
        }
    }
}
"
`;

exports[`generateCode samples > java > pipeline with typed values 1`] = `
"import com.mongodb.client.MongoClient;
import com.mongodb.client.MongoClients;
import com.mongodb.client.MongoCollection;
import java.time.Instant;
import java.util.Arrays;
import java.util.Date;
import java.util.List;
import org.bson.BsonTimestamp;
import org.bson.Document;
import org.bson.types.Decimal128;

public class Query {
    public static void main(String[] args) {
        try (MongoClient client = MongoClients.create("mongodb://localhost:27017")) {
            MongoCollection<Document> coll =
                    client.getDatabase("shop").getCollection("orders");
            coll.aggregate(List.of(
                new Document(
                    "$match",
                    new Document(
                        "createdAt",
                        new Document(
                            "$gte",
                            Date.from(Instant.parse("2020-02-29T12:00:00.000Z"))
                        )
                    )
                        .append(
                            "amount",
                            new Document(
                                "$in",
                                Arrays.asList(
                                    5L,
                                    Decimal128.parse("1.10"),
                                    2.0,
                                    7
                                )
                            )
                        )
                ),
                new Document(
                    "$addFields",
                    new Document("tags", Arrays.asList("a", "b"))
                        .append(
                            "nested",
                            new Document(
                                "deep",
                                new Document(
                                    "deeper",
                                    Arrays.asList(
                                        1,
                                        Arrays.asList(2, Arrays.asList(3))
                                    )
                                )
                            )
                        )
                        .append("ts", new BsonTimestamp(-1L))
                ),
                new Document("$project", new Document("_id", 0))
            ))
                .forEach(doc -> System.out.println(doc.toJson()));
        }
    }
}
"
`;

exports[`generateCode samples > node > empty pipeline 1`] = `
"const { BSON, MongoClient } = require('mongodb');

async function main() {
  const client = new MongoClient("mongodb://localhost:27017");
  try {
    const coll = client.db("shop").collection("orders");
    const cursor = coll.aggregate([]);
    for await (const doc of cursor) {
      console.log(BSON.EJSON.stringify(doc));
    }
  } finally {
    await client.close();
  }
}

main().catch((error) => {
  console.error(error);
  process.exitCode = 1;
});
"
`;

