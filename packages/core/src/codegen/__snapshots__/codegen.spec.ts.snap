"const { BSON, Decimal128, Double, Long, MongoClient, Timestamp } = require('mongodb');

async function main() {
  const client = new MongoClient("mongodb://localhost:27017");
  try {
    const coll = client.db("shop").collection("orders");
    const cursor = coll.aggregate([
      {
        $match: {
          createdAt: { $gte: new Date("2020-02-29T12:00:00.000Z") },
          amount: {
            $in: [
              Long.fromString("5"),
              Decimal128.fromString("1.10"),
              new Double(2),
              7
            ]
          }
        }
      },
      {
        $addFields: {
          tags: ["a", "b"],
          nested: { deep: { deeper: [1, [2, [3]]] } },
          ts: new Timestamp({ t: 4294967295, i: 4294967295 })
        }
      },
      { $project: { _id: 0 } }
    ]);
    for await (const doc of cursor) {
      console.log(BSON.EJSON.stringify(doc));
    }
  } finally {
    await client.close();
  }
}

main().catch((error) => {
  console.error(error);
  process.exitCode = 1;
});
"
