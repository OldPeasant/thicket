exports[`generateCode samples > node > find with filter, projection, sort, skip and limit 1`] = `
"const { BSON, Decimal128, MongoClient } = require('mongodb');

async function main() {
  const client = new MongoClient("mongodb://localhost:27017");
  try {
    const coll = client.db("shop").collection("orders");
    const cursor = coll.find(
      { status: "open", total: { $gt: Decimal128.fromString("100.50") } },
      {
        projection: { _id: 0, status: 1, total: 1 },
        sort: { total: -1, _id: 1 },
        skip: 10,
        limit: 5
      }
    );
    for await (const doc of cursor) {
      console.log(BSON.EJSON.stringify(doc));
    }
  } finally {
    await client.close();
  }
}

main().catch((error) => {
  console.error(error);
  process.exitCode = 1;
});
"
`;

