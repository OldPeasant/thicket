    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "~22.2.7",
    "@angular/cli": "~22.2.7",
    "@angular/compiler-cli": "~22.2.6",
    "jsdom": "^31.0.1"
  }
}
