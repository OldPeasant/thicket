{
  "name": "@thicket/desktop",
  "productName": "Thicket",
  "desktopName": "thicket.desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Electron main process, preload script and packaging",
  "license": "Apache-2.0",
  "author": {
    "name": "Thicket contributors",
    "email": "thicket@users.noreply.github.com"
  },
  "homepage": "https://github.com/oldpeasant/thicket",
  "type": "module",
  "main": "dist/main.cjs",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:electron": "node scripts/build.mjs && vitest run --config vitest.electron.config.ts",
    "coverage": "vitest run --coverage",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build -w @thicket/renderer && node scripts/build.mjs && electron-builder --config electron-builder.yml --publish never",
    "dist:dir": "npm run build -w @thicket/renderer && node scripts/build.mjs && electron-builder --config electron-builder.yml --publish never --dir"
  },
  "devDependencies": {
    "@thicket/backend": "0.0.0",
    "@thicket/contract": "0.0.0",
    "@thicket/core": "0.0.0",
    "electron": "45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1"
  }
}
